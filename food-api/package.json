{
  "name": "food-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "mkdir -p dist/sql dist/data && cp -R sql/. dist/sql/ && cp -R data/. dist/data/",
    "start": "node dist/src/index.js",
    "dev": "node --watch src/index.ts",
    "seed:food": "node dist/scripts/seed-food.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.9",
    "hono": "4.6.14",
    "mysql2": "3.11.5"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "typescript": "5.8.3"
  }
}
